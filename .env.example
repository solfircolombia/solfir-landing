# Contentful Delivery API. Create a new delivery token in Contentful and
# do not reuse the token that used to be committed in gatsby-config.ts.
CONTENTFUL_SPACE_ID=
CONTENTFUL_ACCESS_TOKEN=
CONTENTFUL_ENVIRONMENT=master

# SendGrid dynamic template used by the contact form.
# The endpoint stays disabled (redirects to /error/) until these are set.
# SENDGRID_AUTHORIZED_EMAIL is used when SENDGRID_AUTHORIZED_DOMAIN_EMAIL is empty.
SENDGRID_API_KEY=
SENDGRID_AUTHORIZED_DOMAIN_EMAIL=
SENDGRID_AUTHORIZED_EMAIL=
SOLFIR_CONTACT_REQUEST_EMAIL=
SENDGRID_CONTACT_REQUEST_TEMPLATE_ID=

# Google Analytics 4 measurement id (G-XXXXXXXX). Leave empty to keep analytics off.
PUBLIC_GA_MEASUREMENT_ID=

# Canonical site URL used for SEO, sitemap, and Open Graph tags.
PUBLIC_SITE_URL=https://solfir.com.co

# Build-time switch. true shows the maintenance screen instead of the site.
MAINTENANCE=false
