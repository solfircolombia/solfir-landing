{
    "name": "solfir-landing",
    "version": "1.0.0",
    "private": true,
    "description": "SOLFIR Colombia landing site",
    "author": "Andres Artunduaga",
    "type": "module",
    "engines": {
        "node": ">=24"
    },
    "scripts": {
        "dev": "astro dev --host 0.0.0.0",
        "start": "astro dev --host 0.0.0.0",
        "build": "astro build",
        "preview": "astro preview --host 0.0.0.0",
        "check": "astro check",
        "test:a11y": "node scripts/a11y.mjs",
        "typecheck": "astro check",
        "format:check": "prettier --check .",
        "format:write": "prettier --write .",
        "prepare": "husky"
    },
    "lint-staged": {
        "**/*": "prettier --write --ignore-unknown"
    },
    "devDependencies": {
        "@axe-core/playwright": "^4.14.0",
        "@types/node": "^24.19.2",
        "husky": "^9.1.7",
        "lint-staged": "^17.6.0",
        "playwright": "^1.64.1",
        "prettier": "^3.9.10",
        "prettier-plugin-astro": "^1.1.1",
        "typescript": "^5.9.3"
    },
    "dependencies": {
        "@astrojs/check": "^0.9.12",
        "@astrojs/netlify": "^6.6.5",
        "@astrojs/sitemap": "^3.7.4",
        "@contentful/rich-text-html-renderer": "^17.2.3",
        "@contentful/rich-text-types": "^17.2.7",
        "@sendgrid/mail": "^8.1.6",
        "@tailwindcss/vite": "^4.3.3",
        "astro": "^5.18.2",
        "tailwindcss": "^4.3.3"
    },
    "allowScripts": {
        "esbuild@0.25.12": true,
        "esbuild@0.27.7": true,
        "esbuild@0.28.1": true,
        "sharp@0.34.5": true
    }
}
