---
interface Props {
    image?: {
        src: string;
        alt: string;
    };
}

const { image } = Astro.props;
---

<section class="hero" id="landing-banner" data-hero={image ? 'image' : 'type'}>
    {
        image && (
            <img
                class="hero-image"
                src={image.src}
                alt={image.alt}
                width="1140"
                height="640"
                decoding="async"
            />
        )
    }
    <div class="container">
        <h1 class="hero-title">
            <slot name="title" />
        </h1>
        <div class="hero-actions">
            <slot />
        </div>
    </div>
</section>
