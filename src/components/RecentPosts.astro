---
import { getRecentPosts } from '../lib/contentful';
import { blogPath } from '../lib/site';
import ContentImage from './ContentImage.astro';

const posts = await getRecentPosts(3);
---

<aside class="recent-posts">
    <h2 class="section-title">Últimas publicaciones</h2>
    <div class="card-grid">
        {
            posts.map((post) => (
                <article class="surface-card">
                    {post.image && (
                        <div class="card-media">
                            <ContentImage
                                image={post.image}
                                alt=""
                                widths={[200, 400]}
                                sizes="280px"
                            />
                        </div>
                    )}
                    <div class="card-body">
                        <h3 class="card-title">{post.title}</h3>
                        <a class="card-link" href={blogPath(post.slug)}>
                            Leer post
                        </a>
                    </div>
                </article>
            ))
        }
    </div>
</aside>
