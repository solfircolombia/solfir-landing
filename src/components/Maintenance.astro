---
import Logo from './Logo.astro';
import Loader from './Loader.astro';
import Settings from './Settings.astro';
import SocialLinks from './SocialLinks.astro';
---

<a class="skip-link" href="#contenido">Saltar al contenido</a>
<main class="maintenance" id="contenido" tabindex="-1">
    <Logo />
    <h1>
        Página en construccion
        <span class="maintenance-message-loader">
            <Loader fill="primary" />
        </span>
    </h1>
    <p>Mientras tanto puedes visitarnos en nuestras redes sociales</p>
    <div class="icon-row">
        <SocialLinks variant="primary" />
    </div>
    <Settings />
</main>
