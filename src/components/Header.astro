---
import { LABELS, NAV_LINKS, isCurrentPath } from '../lib/site';
import Button from './Button.astro';
import Icon from './Icon.astro';
import Logo from './Logo.astro';
import Modal from './Modal.astro';

const pathname = Astro.url.pathname;
---

<header class="header">
    <div class="wrapper">
        <div class="header-logo">
            <Logo class="header-logo-solfir" />
            <Button
                id="nav-toggle"
                class="header-logo-menu"
                variant="light"
                btnStyle="rounded"
                size={48}
                ariaLabel={LABELS.menu}
                ariaExpanded="false"
                ariaControls="nav-modal"
            >
                <span data-icon="menu">
                    <Icon name="menu" size={26} />
                </span>
                <span data-icon="close" hidden>
                    <Icon name="close" size={26} />
                </span>
            </Button>
        </div>
        <div class="header-links">
            <nav class="header-links-wrapper" aria-label="Principal">
                {
                    NAV_LINKS.map((item) => (
                        <a
                            class:list={[
                                'header-links-item',
                                isCurrentPath(pathname, item.href) && 'header-links-item-active',
                            ]}
                            href={item.href}
                        >
                            {item.label}
                        </a>
                    ))
                }
            </nav>
        </div>
    </div>
</header>

<Modal id="nav-modal" label="Menú principal">
    <nav aria-label="Menú">
        <div class="header-links-modal">
            {
                NAV_LINKS.map((item) => (
                    <a
                        class:list={[
                            'header-links-modal-item',
                            isCurrentPath(pathname, item.href) && 'header-links-modal-item-active',
                        ]}
                        href={item.href}
                    >
                        {item.label}
                    </a>
                ))
            }
        </div>
    </nav>
</Modal>

<script>
    import { bindModal } from '../scripts/modal';

    const modal = document.getElementById('nav-modal');
    const button = document.getElementById('nav-toggle');
    if (modal && button) {
        const controller = bindModal(modal, { onClose: () => setOpen(false) });
        const menuIcon = button.querySelector<HTMLElement>('[data-icon="menu"]');
        const closeIcon = button.querySelector<HTMLElement>('[data-icon="close"]');

        const setOpen = (open: boolean) => {
            if (menuIcon) menuIcon.hidden = open;
            if (closeIcon) closeIcon.hidden = !open;
            button.setAttribute('aria-expanded', String(open));
            button.setAttribute('aria-label', open ? 'Cerrar menú' : 'Menú');
        };

        button.addEventListener('click', () => {
            if (modal.hidden) {
                setOpen(true);
                controller.open();
            } else {
                controller.close();
            }
        });

        const root = document.documentElement;
        const header = document.querySelector<HTMLElement>('.header');
        const links = header?.querySelector<HTMLElement>('.header-links');

        const inlineFits = () => {
            if (!header || !links) {
                return true;
            }
            root.dataset.nav = 'inline';
            const items = Array.from(links.querySelectorAll<HTMLElement>('.header-links-item'));
            if (window.innerWidth < 768) {
                return false;
            }
            const visible = items.filter((item) => item.getClientRects().length > 0);
            if (visible.length !== items.length) {
                return false;
            }
            const headerBox = header.getBoundingClientRect();
            const rects = visible.map((item) => item.getBoundingClientRect());
            const clipped = rects.some(
                (rect) =>
                    rect.left < headerBox.left - 0.5 ||
                    rect.right > headerBox.right + 0.5 ||
                    rect.top < headerBox.top - 0.5 ||
                    rect.bottom > headerBox.bottom + 0.5
            );
            const ordered = [...rects].sort((a, b) => a.left - b.left || a.top - b.top);
            const overlap = ordered.some((rect, index) => {
                const previous = ordered[index - 1];
                if (!previous) {
                    return false;
                }
                const sameRow = rect.top < previous.bottom - 1 && previous.top < rect.bottom - 1;
                return sameRow && rect.left < previous.right - 1;
            });
            const pageOverflow =
                document.documentElement.scrollWidth > document.documentElement.clientWidth + 1;
            return !clipped && !overlap && !pageOverflow;
        };

        let frame = 0;
        const syncNav = () => {
            cancelAnimationFrame(frame);
            frame = requestAnimationFrame(() => {
                const open = !modal.hidden;
                const fits = inlineFits();
                root.dataset.nav = fits ? 'inline' : 'compact';
                if (fits && open) {
                    controller.close();
                }
            });
        };

        syncNav();
        window.addEventListener('resize', syncNav);
        document.fonts?.ready.then(syncNav);
        new MutationObserver(syncNav).observe(root, {
            attributes: true,
            attributeFilter: ['data-text-size'],
        });
    }
</script>
