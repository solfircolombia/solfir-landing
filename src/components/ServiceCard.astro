---
import type { IconName } from '../lib/icons';
import Icon from './Icon.astro';

interface Props {
    title: string;
    description?: string;
    icon: IconName;
    heading?: 'h2' | 'h3';
}

const { title, description, icon, heading = 'h2' } = Astro.props;
const Heading = heading;
---

<article class="surface-card service-card">
    <Icon name={icon} />
    <Heading class="card-title">{title}</Heading>
    {description && <p class="card-text">{description}</p>}
    <div>
        <slot />
    </div>
</article>
