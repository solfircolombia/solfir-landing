---
import type { BlogPost } from '../lib/contentful';
import { blogPath } from '../lib/site';
import ContentImage from './ContentImage.astro';
import Icon from './Icon.astro';

interface Props {
    post: BlogPost;
    layout?: 'horizontal';
    class?: string;
}

const { post, layout, class: className = '' } = Astro.props;
---

<article class:list={['surface-card', layout === 'horizontal' && 'blog-card--horizontal', className]}>
    {
        post.image && (
            <div class="card-media">
                <ContentImage
                    image={post.image}
                    alt=""
                    widths={layout === 'horizontal' ? [320, 480, 640] : [300, 480, 640]}
                    sizes={
                        layout === 'horizontal'
                            ? '(max-width: 768px) 100vw, 280px'
                            : '(max-width: 768px) 90vw, 360px'
                    }
                />
            </div>
        )
    }
    <div class="card-body">
        <h3 class="card-title">{post.title}</h3>
        {post.summary && <p class="card-text">{post.summary}</p>}
        <a class="card-link" href={blogPath(post.slug)}>
            Leer más
            <Icon name="arrow-right" />
        </a>
    </div>
</article>
