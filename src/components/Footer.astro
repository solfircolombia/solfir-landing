---
import { CONTACT, CREDITS, NAV_LINKS, isCurrentPath } from '../lib/site';
import Icon from './Icon.astro';
import Logo from './Logo.astro';
import SocialLinks from './SocialLinks.astro';

const pathname = Astro.url.pathname;
const year = new Date().getFullYear();
---

<footer class="footer">
    <div class="footer-wrapper">
        <span class="footer-logo">
            <Logo variant="primary" />
        </span>
        <div class="footer-columns">
            <div>
                <h2>Datos de contacto</h2>
                <div class="contact-row">
                    <span>
                        <Icon name="mail" variant="light" />
                        Correo electrónico
                    </span>
                    <a class="footer-link" href={`mailto:${CONTACT.mail}`}>
                        {CONTACT.mail}
                    </a>
                </div>
                <div class="contact-row">
                    <span>
                        <Icon name="phone" variant="light" />
                        Teléfono
                    </span>
                    <a class="footer-link" href={`tel:${CONTACT.phone}`}>
                        {CONTACT.phone}
                    </a>
                </div>
                <div class="contact-row">
                    <span>
                        <Icon name="place" variant="light" />
                        Ubicación
                    </span>
                    <a class="footer-link" href={CONTACT.maps}>
                        {CONTACT.address}
                    </a>
                </div>
            </div>
            <div>
                <h2>Enlaces</h2>
                <nav aria-label="Pie de página">
                    {NAV_LINKS.map((item) => (
                        <a
                            class:list={[
                                'footer-link',
                                isCurrentPath(pathname, item.href) && 'footer-link-active',
                            ]}
                            href={item.href}
                        >
                            {item.label}
                        </a>
                    ))}
                </nav>
            </div>
        </div>
        <div>
            <h2>Visitanos en nuestras redes sociales</h2>
            <div class="social-row">
                <SocialLinks variant="secondary" />
            </div>
        </div>
        <p class="fine-print">
            {`SOLFIR - Soluciones financieras y reorganizaciones S.A.S © Todos los derechos reservados | ${year}`}
        </p>
        <p class="fine-print credits">
            {CREDITS.map((credit) => (
                <span>
                    {credit.role}{' '}
                    {credit.href ? (
                        <a href={credit.href} target="_blank" rel="noopener noreferrer">
                            {credit.label}
                        </a>
                    ) : (
                        <span>{credit.label}</span>
                    )}
                </span>
            ))}
        </p>
        <p class="photo-credit">
            Fotografías:{' '}
            <a href="https://unsplash.com" target="_blank" rel="noopener noreferrer">
                Unsplash
                <span class="visually-hidden"> (se abre en una pestaña nueva)</span>
            </a>
        </p>
    </div>
</footer>
