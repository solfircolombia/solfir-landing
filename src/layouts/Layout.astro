---
import { MAINTENANCE } from 'astro:env/server';
import { PUBLIC_GA_MEASUREMENT_ID } from 'astro:env/client';
import { CONTACT, SITE, type SeoInput } from '../lib/site';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import Settings from '../components/Settings.astro';
import Maintenance from '../components/Maintenance.astro';
import Icon from '../components/Icon.astro';
import champagneRegular from '../assets/fonts/champagne-limousines.woff2?url';
import champagneBold from '../assets/fonts/champagne-limousines-bold.woff2?url';
import '../styles/global.css';

interface Props {
    seo: SeoInput;
}

const { seo } = Astro.props;
const siteUrl = (Astro.site ?? new URL(SITE.url)).toString().replace(/\/$/, '');
const description = seo.description || SITE.description;
const imageSource = seo.image || SITE.image;
const imageUrl = imageSource.startsWith('http')
    ? imageSource
    : new URL(imageSource, `${siteUrl}/`).toString();
const canonical = new URL(seo.pathname || Astro.url.pathname, `${siteUrl}/`).toString();
const documentTitle = `${SITE.name} - ${seo.title}`;
const gaId = PUBLIC_GA_MEASUREMENT_ID?.trim() ?? '';
const maintenance = MAINTENANCE;
---

<!doctype html>
<html lang="es">
    <head>
        <meta charset="utf-8" />
        <meta name="viewport" content="width=device-width, initial-scale=1" />
        <script is:inline>
            (function () {
                var root = document.documentElement;
                var mode = 'system';
                var contrast = false;
                var size = 'md';
                try {
                    mode = localStorage.getItem('solfir-theme') || 'system';
                    contrast = localStorage.getItem('solfir-contrast') === 'high';
                    size = localStorage.getItem('solfir-text-size') || 'md';
                } catch (error) {}
                if (mode !== 'light' && mode !== 'dark' && mode !== 'system') mode = 'system';
                if (size !== 'sm' && size !== 'md' && size !== 'lg' && size !== 'xl') size = 'md';
                var dark =
                    mode === 'dark' ||
                    (mode === 'system' &&
                        window.matchMedia('(prefers-color-scheme: dark)').matches);
                root.setAttribute('data-theme', dark ? 'dark' : 'light');
                root.setAttribute('data-theme-mode', mode);
                root.setAttribute('data-text-size', size);
                if (contrast) root.setAttribute('data-contrast', 'high');
                var scale =
                    size === 'xl' ? 1.25 : size === 'lg' ? 1.125 : size === 'sm' ? 0.875 : 1;
                if (window.innerWidth < 768 || window.innerWidth < 860 * scale + 280) {
                    root.setAttribute('data-nav', 'compact');
                }
            })();
        </script>
        <title>{documentTitle}</title>
        <meta name="description" content={description} />
        {seo.noindex && <meta name="robots" content="noindex, nofollow" />}
        <meta name="image" content={imageUrl} />
        <link rel="canonical" href={canonical} />
        <meta property="og:type" content={seo.ogType ?? 'website'} />
        <meta property="og:locale" content="es_CO" />
        <meta property="og:site_name" content={SITE.title} />
        <meta property="og:title" content={seo.title} />
        <meta property="og:description" content={description} />
        <meta property="og:url" content={canonical} />
        <meta property="og:image" content={imageUrl} />
        <meta name="twitter:card" content="summary_large_image" />
        <meta name="twitter:title" content={seo.title} />
        <meta name="twitter:url" content={canonical} />
        <meta name="twitter:description" content={description} />
        <meta name="twitter:image" content={imageUrl} />
        <meta name="twitter:creator" content={SITE.twitter} />
        <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
        <link rel="apple-touch-icon" href="/icon.png" />
        <link rel="manifest" href="/site.webmanifest" />
        <meta name="theme-color" content="#012651" />
        <link rel="preload" href={champagneRegular} as="font" type="font/woff2" crossorigin />
        <link rel="preload" href={champagneBold} as="font" type="font/woff2" crossorigin />
        <meta name="generator" content={Astro.generator} />
        {gaId && (
            <>
                <script async src={`https://www.googletagmanager.com/gtag/js?id=${gaId}`}></script>
                <script is:inline define:vars={{ gaId }}>
                    window.dataLayer = window.dataLayer || [];
                    function gtag() {
                        window.dataLayer.push(arguments);
                    }
                    gtag('js', new Date());
                    gtag('config', gaId);
                </script>
            </>
        )}
    </head>
    <body>
        {maintenance ? (
            <Maintenance />
        ) : (
            <div class="layout" id="layout">
                <a class="skip-link" href="#contenido">
                    Saltar al contenido
                </a>
                <Header />
                <main class="content" id="contenido" tabindex="-1">
                    <slot />
                </main>
                <Footer />
                <a
                    class="bubble"
                    target="_blank"
                    rel="noopener noreferrer"
                    href={CONTACT.whatsapp}
                    aria-label="Click aqui para abrir un chat con uno de nuestros asesores"
                >
                    <Icon class="icon" name="whatsapp" fill="white" />
                </a>
                <Settings />
            </div>
        )}
    </body>
</html>
