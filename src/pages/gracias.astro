---
import Layout from '../layouts/Layout.astro';
import { LABELS, PAGE_SEO, PATHS } from '../lib/site';
---

<Layout seo={PAGE_SEO.thanks}>
    <div class="container">
        <div class="surface-card message">
            <h1>¡Gracias por contactarnos!</h1>
            <p>Pronto nos estaremos comunicando contigo</p>
            <a href={PATHS.home}>{`Volver al ${LABELS.home}`}</a>
        </div>
    </div>
</Layout>
