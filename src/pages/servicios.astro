---
import Layout from '../layouts/Layout.astro';
import Button from '../components/Button.astro';
import PageHeader from '../components/PageHeader.astro';
import ServiceCard from '../components/ServiceCard.astro';
import { getServices } from '../lib/contentful';
import { PAGE_SEO, servicePath } from '../lib/site';

const services = await getServices();
---

<Layout seo={PAGE_SEO.services}>
    <PageHeader title="Conoce nuestros servicios" />
    <div class="container band" style="padding-top: 0">
        <div class="card-grid">
            {
                services.map((service) => (
                    <ServiceCard
                        title={service.title}
                        description={service.description}
                        icon={service.icon}
                    >
                        <Button size="small" href={servicePath(service.slug)}>
                            Leer más
                        </Button>
                    </ServiceCard>
                ))
            }
        </div>
    </div>
</Layout>
