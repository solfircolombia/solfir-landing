---
import Layout from '../layouts/Layout.astro';
import BlogCard from '../components/BlogCard.astro';
import Button from '../components/Button.astro';
import Icon from '../components/Icon.astro';
import ServiceCard from '../components/ServiceCard.astro';
import TeamCard from '../components/TeamCard.astro';
import { getBlogPosts, getServices, getTeamMembers } from '../lib/contentful';
import type { IconName } from '../lib/icons';
import { teamPath } from '../lib/site';
import { contrastRatio, formatRatio, meetsAa } from '../lib/contrast';
import { palette, themeSamples } from '../lib/palette';

const typeSteps = [
    { name: 'xs', size: 'var(--primitive-font-size-xs)', sample: 'Nota auxiliar' },
    { name: 'sm', size: 'var(--primitive-font-size-sm)', sample: 'Texto pequeño' },
    { name: 'body', size: 'var(--primitive-font-size-body)', sample: 'Texto de interfaz' },
    { name: 'lg', size: 'var(--primitive-font-size-lg)', sample: 'Subtítulo' },
    { name: 'xl', size: 'var(--primitive-font-size-xl)', sample: 'Título de sección menor' },
    { name: '2xl', size: 'var(--primitive-font-size-2xl)', sample: 'Título de sección' },
    { name: '3xl', size: 'var(--primitive-font-size-3xl)', sample: 'Título de página' },
    { name: 'display', size: 'var(--primitive-font-size-display)', sample: 'Titular de portada' },
];

const spaces = [
    ['1', 'var(--primitive-space-1)'],
    ['2', 'var(--primitive-space-2)'],
    ['3', 'var(--primitive-space-3)'],
    ['4', 'var(--primitive-space-4)'],
    ['5', 'var(--primitive-space-5)'],
    ['6', 'var(--primitive-space-6)'],
    ['8', 'var(--primitive-space-8)'],
    ['10', 'var(--primitive-space-10)'],
] as const;

const samplePost = (await getBlogPosts())[0];
const sampleService = (await getServices())[0];
const sampleMember = (await getTeamMembers())[0];

const serviceIcons: { name: IconName; source: string }[] = [
    { name: 'shield-check', source: 'GppGood' },
    { name: 'handshake', source: 'Handshake' },
    { name: 'trending-up', source: 'TrendingUp' },
    { name: 'savings', source: 'Savings' },
];

/** High-contrast dark cards use this surface. It matches tokens.css. */
const highContrastDarkSurface = '#141414';

const serviceIconPairs = [
    {
        label: 'Claro, icono sobre tarjeta',
        foreground: palette.navy,
        background: palette.white,
    },
    {
        label: 'Oscuro, icono sobre tarjeta',
        foreground: palette.emphasisDark,
        background: palette.surfaceDark,
    },
    {
        label: 'Alto contraste claro, icono sobre tarjeta',
        foreground: palette.black,
        background: palette.white,
    },
    {
        label: 'Alto contraste oscuro, icono sobre tarjeta',
        foreground: palette.white,
        background: highContrastDarkSurface,
    },
    {
        label: 'Claro, icono en cabecera',
        foreground: palette.white,
        background: palette.navy,
    },
    {
        label: 'Oscuro, icono en cabecera',
        foreground: palette.textDark,
        background: palette.footerDark,
    },
    {
        label: 'Alto contraste, icono en cabecera',
        foreground: palette.white,
        background: palette.black,
    },
];

const primitives = [
    ['Navy', palette.navy],
    ['Amarillo', palette.yellow],
    ['Blanco', palette.white],
    ['Tinta', palette.ink],
    ['Negro', palette.black],
    ['Atenuado', palette.muted],
    ['Lienzo oscuro', palette.canvasDark],
    ['Texto oscuro', palette.textDark],
] as const;
---

<Layout
    seo={{
        title: 'Sistema de diseño',
        description: 'Tokens, tipografía y temas internos de SOLFIR.',
        pathname: '/design-system/',
        noindex: true,
    }}
>
    <article class="ds">
        <header class="ds-intro">
            <h1>Sistema de diseño</h1>
            <p>
                Página interna. No está en el mapa del sitio. La paleta es Marino institucional: el
                azul <span class="ds-code">{palette.navy}</span> es el color primario y el amarillo{' '}
                <span class="ds-code">{palette.yellow}</span> es solo acento.
            </p>
        </header>

        <section class="ds-section" aria-labelledby="ds-tokens">
            <h2 id="ds-tokens">Tokens</h2>
            <h3>Primitivos</h3>
            <ul class="ds-swatches">
                {primitives.map(([name, hex]) => (
                    <li>
                        <span class="ds-chip" style={`background:${hex}`} />
                        <span>
                            {name}
                            <span class="ds-code">{hex}</span>
                        </span>
                    </li>
                ))}
            </ul>
            <h3>Semánticos y de componente</h3>
            <p>
                Los tokens semánticos cambian con <span class="ds-code">data-theme</span> y
                <span class="ds-code">data-contrast</span>. Los de componente (
                <span class="ds-code">--component-button-bg</span>,
                <span class="ds-code">--component-header-bg</span>,
                <span class="ds-code">--component-footer-link</span>,
                <span class="ds-code">--component-focus-color</span>) apuntan a esos valores.
                Tailwind los expone con <span class="ds-code">@theme inline</span>.
            </p>
        </section>

        <section class="ds-section" aria-labelledby="ds-type">
            <h2 id="ds-type">Tipografía</h2>
            <p>
                Plus Jakarta Sans en interfaz y texto. Literata en titulares, con Georgia como
                respaldo. La escala es fluida con <span class="ds-code">clamp()</span> y se reduce
                en pantallas pequeñas. El tamaño de texto A-, A, A+, A++ escala la raíz.
            </p>
            <ul class="ds-type">
                {typeSteps.map((step) => (
                    <li>
                        <span class="ds-code">{step.name}</span>
                        <span
                            style={`font-size:${step.size};font-family:${
                                step.name === 'display' ||
                                step.name === '3xl' ||
                                step.name === '2xl'
                                    ? 'var(--semantic-font-display)'
                                    : 'var(--semantic-font-body)'
                            }`}
                        >
                            {step.sample}
                        </span>
                    </li>
                ))}
            </ul>
        </section>

        <section class="ds-section" aria-labelledby="ds-color">
            <h2 id="ds-color">Color y contraste</h2>
            <p>
                Los pares marcados como texto cumplen WCAG 2.2 AA (4.5:1). El acento sobre blanco no
                se usa como texto.
            </p>
            {themeSamples.map((sample) => (
                <div class="ds-theme" data-theme={sample.theme} data-contrast={sample.contrast}>
                    <h3>{sample.name}</h3>
                    <ul class="ds-pairs">
                        {sample.pairs.map((pair) => {
                            const ratio = contrastRatio(pair.foreground, pair.background);
                            const pass = pair.forbidden ? false : meetsAa(ratio, pair.large);
                            return (
                                <li>
                                    <span
                                        class="ds-pair-swatch"
                                        style={`background:${pair.background}`}
                                    />
                                    <span>
                                        {pair.label}
                                        <span class="ds-code">
                                            {pair.foreground} sobre {pair.background} ·{' '}
                                            {formatRatio(ratio)} · {pass ? 'AA' : 'no AA'}
                                        </span>
                                    </span>
                                </li>
                            );
                        })}
                    </ul>
                    <div class="ds-preview">
                        <p>Texto de muestra sobre el fondo del tema.</p>
                        <Button variant="primary">Acción</Button>
                    </div>
                </div>
            ))}
        </section>

        <section class="ds-section" aria-labelledby="ds-components">
            <h2 id="ds-components">Componentes</h2>
            <h3>Botones</h3>
            <div class="ds-row">
                <Button variant="primary">Primario</Button>
                <Button variant="secondary">Acento</Button>
                <Button variant="light">Claro</Button>
            </div>
            <h3>Espacio, radio y sombra</h3>
            <ul class="ds-spaces">
                {spaces.map(([name, size]) => (
                    <li>
                        <span class="ds-space" style={`width:${size}`} />
                        <span class="ds-code">{name}</span>
                    </li>
                ))}
            </ul>
            <div class="ds-row">
                <span class="ds-radius ds-radius-sm">sm</span>
                <span class="ds-radius ds-radius-md">md</span>
                <span class="ds-radius ds-radius-lg">lg</span>
                <span class="ds-radius ds-radius-pill">pill</span>
            </div>
            <p class="ds-shadow">Sombra 3, el mismo token que las tarjetas.</p>
        </section>

        <section class="ds-section" aria-labelledby="ds-library">
            <h2 id="ds-library">Biblioteca</h2>
            <p>
                Tarjetas, prosa, formulario, bandas y modales usan los tokens semánticos. El patrón
                geométrico es una máscara del lienzo, más suave en el tema oscuro.
            </p>
            <h3>Tarjeta de blog</h3>
            {samplePost && <BlogCard post={samplePost} />}
            <h3>Iconos de servicio</h3>
            <p>
                Cuatro iconos Material 24px, los mismos trazos que
                <span class="ds-code">@mui/icons-material</span>: shield-check, handshake,
                trending-up y savings. En la tarjeta el icono usa el color de marca sobre la
                superficie. En la cabecera de cada servicio usa el texto del encabezado. El umbral
                de contraste no textual es 3:1.
            </p>
            <div class="ds-icon-stage ds-icon-stage-card">
                {serviceIcons.map((icon) => (
                    <span class="ds-icon-item">
                        <Icon name={icon.name} />
                        <span>
                            {icon.name}
                            <span class="ds-code">{icon.source}</span>
                        </span>
                    </span>
                ))}
            </div>
            <div class="ds-icon-stage ds-icon-stage-header">
                {serviceIcons.map((icon) => (
                    <span class="ds-icon-item">
                        <Icon name={icon.name} />
                        <span>{icon.name}</span>
                    </span>
                ))}
            </div>
            <ul class="ds-pairs">
                {serviceIconPairs.map((pair) => {
                    const ratio = contrastRatio(pair.foreground, pair.background);
                    const pass = ratio >= 3;
                    return (
                        <li>
                            <span
                                class="ds-pair-swatch"
                                style={`background:${pair.background};color:${pair.foreground}`}
                            >
                                <Icon name="shield-check" />
                            </span>
                            <span>
                                {pair.label}
                                <span class="ds-code">
                                    {pair.foreground} sobre {pair.background} · {formatRatio(ratio)}{' '}
                                    · {pass ? '3:1' : 'bajo 3:1'}
                                </span>
                            </span>
                        </li>
                    );
                })}
            </ul>
            <h3>Tarjeta de servicio</h3>
            {sampleService && (
                <ServiceCard
                    title={sampleService.title}
                    description={sampleService.description}
                    icon={sampleService.icon}
                    image={sampleService.image}
                    heading="h3"
                />
            )}
            <h3>Tarjeta de equipo</h3>
            {sampleMember && (
                <TeamCard
                    name={sampleMember.name}
                    role={sampleMember.role}
                    href={teamPath(sampleMember.slug)}
                    avatar={sampleMember.avatar}
                    heading="h3"
                />
            )}
            <h3>Prosa</h3>
            <div class="prose">
                <p>
                    El cuerpo del artículo usa Plus Jakarta Sans, interlineado 1.7 y enlaces
                    subrayados del color del texto.
                </p>
                <h4>Un subtítulo de artículo</h4>
                <p>Literata queda en los títulos. El amarillo no se usa como color de texto.</p>
            </div>
            <h3>Campo con error</h3>
            <form class="surface-card form-card" action="#ds-library">
                <div class="field">
                    <label class="field-label" for="ds-email">
                        Correo
                        <abbr title="obligatorio">*</abbr>
                    </label>
                    <input
                        class="field-control"
                        id="ds-email"
                        type="email"
                        value="correo-invalido"
                        aria-invalid="true"
                        aria-describedby="ds-email-error"
                    />
                    <p class="field-error" id="ds-email-error">
                        Ingresa un correo electrónico válido.
                    </p>
                </div>
            </form>
            <h3>Portada en Contentful</h3>
            <p>
                El hero de inicio sale de la primera entrada publicada de
                <span class="ds-code">homePage</span>. Si no hay entrada, o un campo está vacío, la
                página conserva el texto fijo y la foto local de reserva.
            </p>
            <ul>
                <li>
                    <span class="ds-code">internalName</span> — nombre interno. No se muestra.
                </li>
                <li>
                    <span class="ds-code">heroEyebrow</span> — línea corta sobre el título.
                    Opcional.
                </li>
                <li>
                    <span class="ds-code">heroTitle</span> — título. Obligatorio en Contentful.
                </li>
                <li>
                    <span class="ds-code">heroSubtitle</span> — párrafo bajo el título. Opcional.
                </li>
                <li>
                    <span class="ds-code">heroImage</span> — foto. Es decorativa: el alt queda
                    vacío. No hay crédito por foto. El pie de todas las páginas dice «Fotografías
                    por Unsplash», en la misma línea que el crédito de R2N.
                </li>
                <li>
                    <span class="ds-code">heroImagePosition</span> —
                    <span class="ds-code">left</span>, <span class="ds-code">center</span> o
                    <span class="ds-code">right</span>. Pasa a
                    <span class="ds-code">object-position</span>.
                </li>
                <li>
                    <span class="ds-code">heroPrimaryCtaLabel</span> y
                    <span class="ds-code">heroPrimaryCtaUrl</span> — botón principal. Si faltan, el
                    texto fijo es «Quiero saber más» hacia
                    <span class="ds-code">#landing-services</span>.
                </li>
                <li>
                    <span class="ds-code">heroSecondaryCtaLabel</span> y
                    <span class="ds-code">heroSecondaryCtaUrl</span> — segundo botón. Opcional.
                </li>
            </ul>
            <p>
                En <span class="ds-code">heroTitle</span>, lo que va entre doble asterisco se pinta
                con la negrita del nombre, en el acento <span class="ds-code">#fab114</span>. El
                resto se escapa: no hay HTML. Si el título no trae asteriscos, la palabra SOLFIR se
                marca sola. Ejemplo: <span class="ds-code">con **SOLFIR** expertos</span>.
            </p>
            <p>
                La portada con foto lleva <span class="ds-code">data-theme="dark"</span> en la
                sección, aunque el resto de la página esté en claro. El velo navy, el texto claro y
                el botón usan ese tema. El encabezado sigue el tema elegido. En pantallas chicas el
                velo se apila desde abajo: la foto queda visible arriba y el título, sobre navy
                opaco. Si el documento está en alto contraste, la portada hereda la paleta C — velo
                blanco con texto negro, o velo negro con texto blanco y SOLFIR en
                <span class="ds-code">#fab114</span> — en lugar del tema oscuro normal.
            </p>
            <p>
                La foto de cada servicio usa la descripción del asset como texto alternativo. Las
                tarjetas de inicio y de <span class="ds-code">/servicios/</span> muestran esa
                imagen.
            </p>
            <h3>Banda de acento</h3>
            <div class="band band-accent">
                <p>Texto de tinta sobre el acento. El botón inverso sigue en navy.</p>
                <Button variant="inverse">Contáctanos</Button>
            </div>
        </section>
    </article>
</Layout>

<style>
    .ds {
        width: min(100% - 2rem, 1140px);
        margin: 2rem auto 4rem;
    }

    .ds-intro,
    .ds-section {
        margin-bottom: var(--primitive-space-8);
    }

    .ds h1,
    .ds h2,
    .ds h3 {
        margin-bottom: var(--primitive-space-3);
    }

    .ds h2 {
        font-size: var(--primitive-font-size-3xl);
    }

    .ds h3 {
        font-size: var(--primitive-font-size-xl);
    }

    .ds p,
    .ds li {
        font-family: var(--semantic-font-body);
        font-size: var(--primitive-font-size-body);
        font-weight: 400;
        letter-spacing: 0;
        line-height: 1.5;
    }

    .ds-code {
        color: var(--semantic-color-text-muted);
        font-family: ui-monospace, monospace;
        font-size: var(--primitive-font-size-xs);
    }

    .ds-swatches .ds-code,
    .ds-pairs .ds-code,
    .ds-type .ds-code {
        display: block;
    }

    .ds-swatches,
    .ds-pairs,
    .ds-type,
    .ds-spaces {
        display: grid;
        gap: var(--primitive-space-3);
        margin: 0 0 var(--primitive-space-5);
        padding: 0;
        list-style: none;
    }

    .ds-swatches,
    .ds-pairs {
        grid-template-columns: repeat(auto-fit, minmax(220px, 1fr));
    }

    .ds-swatches li,
    .ds-pairs li,
    .ds-type li,
    .ds-spaces li {
        display: flex;
        align-items: center;
        gap: var(--primitive-space-3);
    }

    .ds-chip,
    .ds-pair-swatch {
        display: flex;
        align-items: center;
        justify-content: center;
        width: 3rem;
        height: 3rem;
        flex: none;
        border: 1px solid var(--semantic-color-text);
        border-radius: var(--primitive-radius-md);
    }

    .ds-theme {
        margin: 0 0 var(--primitive-space-5);
        padding: var(--primitive-space-5);
        background: var(--semantic-color-bg);
        color: var(--semantic-color-text);
        border: 1px solid var(--semantic-color-text);
        border-radius: var(--primitive-radius-lg);
    }

    .ds-theme .ds-code {
        color: var(--semantic-color-text-muted);
    }

    .ds-preview {
        display: flex;
        flex-wrap: wrap;
        align-items: center;
        gap: var(--primitive-space-4);
    }

    .ds-preview p {
        margin: 0;
    }

    .ds-row {
        display: flex;
        flex-wrap: wrap;
        gap: var(--primitive-space-3);
        align-items: center;
        margin-bottom: var(--primitive-space-5);
    }

    .ds-space {
        display: block;
        height: 1rem;
        background: var(--semantic-color-brand);
    }

    .ds-radius {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        min-width: 4.5rem;
        min-height: 3rem;
        padding: 0 var(--primitive-space-3);
        background: var(--semantic-color-brand);
        color: var(--semantic-color-on-brand);
    }

    .ds-radius-sm {
        border-radius: var(--primitive-radius-sm);
    }

    .ds-radius-md {
        border-radius: var(--primitive-radius-md);
    }

    .ds-radius-lg {
        border-radius: var(--primitive-radius-lg);
    }

    .ds-radius-pill {
        border-radius: var(--primitive-radius-pill);
    }

    .ds-shadow {
        padding: var(--primitive-space-5);
        border-radius: var(--primitive-radius-md);
        box-shadow: var(--primitive-shadow-3);
    }

    .ds-icon-stage {
        display: flex;
        flex-wrap: wrap;
        gap: var(--primitive-space-4);
        margin: 0 0 var(--primitive-space-4);
        padding: var(--primitive-space-4);
        border-radius: var(--primitive-radius-lg);
    }

    .ds-icon-stage-card {
        background: var(--semantic-color-surface);
        color: var(--semantic-color-text);
        border: 1px solid color-mix(in srgb, var(--semantic-color-border) 28%, transparent);
    }

    .ds-icon-stage-card .icon {
        color: var(--semantic-color-brand);
    }

    .ds-icon-stage-header {
        background: var(--component-footer-bg);
        color: var(--component-footer-text);
    }

    .ds-icon-stage-header .icon,
    .ds-pair-swatch .icon {
        color: currentColor;
    }

    .ds-icon-item {
        display: flex;
        align-items: center;
        gap: var(--primitive-space-2);
        min-width: 12rem;
    }

    .ds-icon-stage .icon,
    .ds-pair-swatch .icon {
        width: 2.5rem;
        height: 2.5rem;
    }
</style>
