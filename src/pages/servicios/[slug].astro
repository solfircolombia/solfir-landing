---
import Layout from '../../layouts/Layout.astro';
import Button from '../../components/Button.astro';
import ContentImage from '../../components/ContentImage.astro';
import Icon from '../../components/Icon.astro';
import RecentPosts from '../../components/RecentPosts.astro';
import { getBlogPosts, getServices, type Service } from '../../lib/contentful';
import { LABELS, PATHS, SITE, servicePath } from '../../lib/site';

export async function getStaticPaths() {
    const services = await getServices();
    return services.map((service) => ({
        params: { slug: service.slug },
        props: { service },
    }));
}

interface Props {
    service: Service;
}

const { service } = Astro.props;
const posts = await getBlogPosts();
const siteUrl = (Astro.site ?? new URL(SITE.url)).toString().replace(/\/$/, '');
const pageUrl = new URL(servicePath(service.slug), `${siteUrl}/`).toString();
const description = service.description.replace(/\s+/g, ' ').trim();
const truncatedDescription =
    description.length > 160
        ? `${description.slice(0, 157).replace(/\s+\S*$/, '')}...`
        : description;
const metaDescription = service.metaDescription || truncatedDescription;
const faqEntries = service.faq.filter((item) => item.question && item.answer);

const jsonLd = JSON.stringify({
    '@context': 'https://schema.org',
    '@graph': [
        {
            '@type': 'Service',
            name: service.title,
            description: metaDescription || description,
            url: pageUrl,
            ...(service.image ? { image: service.image.url } : {}),
            provider: {
                '@type': 'Organization',
                name: SITE.name,
                url: `${siteUrl}/`,
            },
            areaServed: {
                '@type': 'Country',
                name: 'Colombia',
            },
        },
        {
            '@type': 'BreadcrumbList',
            itemListElement: [
                {
                    '@type': 'ListItem',
                    position: 1,
                    name: LABELS.home,
                    item: `${siteUrl}/`,
                },
                {
                    '@type': 'ListItem',
                    position: 2,
                    name: LABELS.services,
                    item: new URL(PATHS.services, `${siteUrl}/`).toString(),
                },
                {
                    '@type': 'ListItem',
                    position: 3,
                    name: service.title,
                    item: pageUrl,
                },
            ],
        },
        ...(faqEntries.length > 0
            ? [
                  {
                      '@type': 'FAQPage',
                      mainEntity: faqEntries.map((item) => ({
                          '@type': 'Question',
                          name: item.question,
                          acceptedAnswer: {
                              '@type': 'Answer',
                              text: item.answer,
                          },
                      })),
                  },
              ]
            : []),
    ],
}).replace(/</g, '\\u003c');
---

<Layout
    seo={{
        title: service.title,
        description: metaDescription || undefined,
        pathname: servicePath(service.slug),
        image: service.image?.url,
    }}
>
    <article>
        <header class="page-header">
            <div class="container">
                <nav class="crumbs" aria-label="Ruta de navegación">
                    <a href={PATHS.home}>{LABELS.home}</a>
                    <span aria-hidden="true">/</span>
                    <a href={PATHS.services}>{LABELS.services}</a>
                    <span aria-hidden="true">/</span>
                    <span aria-current="page">{service.title}</span>
                </nav>
                <Icon class="page-header-icon" name={service.icon} />
                <h1>{service.title}</h1>
            </div>
        </header>
        <div class="container band service-detail">
            {service.image && (
                <div class="post-hero">
                    <ContentImage
                        image={service.image}
                        widths={[640, 960, 1100]}
                        sizes="(max-width: 768px) 100vw, 1100px"
                        loading="eager"
                    />
                </div>
            )}
            {description && (
                <div class="prose">
                    <p>{description}</p>
                </div>
            )}
            {service.benefits.length > 0 && (
                <section aria-labelledby="service-benefits">
                    <h2 id="service-benefits">Beneficios</h2>
                    <ul class="point-list">
                        {service.benefits.map((benefit) => (
                            <li class="surface-card point">
                                <h3>{benefit.title}</h3>
                                {benefit.text && benefit.text !== benefit.title && (
                                    <p>{benefit.text}</p>
                                )}
                            </li>
                        ))}
                    </ul>
                </section>
            )}
            {service.steps.length > 0 && (
                <section aria-labelledby="service-steps">
                    <h2 id="service-steps">El proceso</h2>
                    <ol class="steps">
                        {service.steps.map((step) => (
                            <li>
                                <h3>{step.title}</h3>
                                {step.text && step.text !== step.title && <p>{step.text}</p>}
                            </li>
                        ))}
                    </ol>
                </section>
            )}
            {service.faq.length > 0 && (
                <section aria-labelledby="service-faq">
                    <h2 id="service-faq">Preguntas frecuentes</h2>
                    <div class="faq">
                        {service.faq.map((item) => (
                            <details>
                                <summary>{item.question}</summary>
                                {item.answer && <p>{item.answer}</p>}
                            </details>
                        ))}
                    </div>
                </section>
            )}
        </div>
        {service.relatedPosts.length > 0 ? (
            <div class="container">
                <RecentPosts posts={service.relatedPosts} title="Publicaciones relacionadas" />
            </div>
        ) : (
            posts.length > 0 && (
                <div class="container">
                    <RecentPosts />
                </div>
            )
        )}
        <section class="band band-accent" aria-labelledby="service-cta">
            <div class="container">
                <h2 id="service-cta">¿Te encuentras interesado en este servicio?</h2>
                <div class="hero-actions">
                    <Button variant="inverse" href={PATHS.contact}>
                        {LABELS.contact}
                    </Button>
                </div>
            </div>
        </section>
    </article>
    <script is:inline type="application/ld+json" set:html={jsonLd} />
</Layout>
