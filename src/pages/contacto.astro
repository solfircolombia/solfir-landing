---
import Layout from '../layouts/Layout.astro';
import Button from '../components/Button.astro';
import PageHeader from '../components/PageHeader.astro';
import { CONTACT, PAGE_SEO } from '../lib/site';
---

<Layout seo={PAGE_SEO.contact}>
    <PageHeader title="Envianos un mensaje" />
    <div class="container" style="margin-bottom: 3rem">
        <section
            class="surface-card form-card contact-details"
            aria-labelledby="contact-details-title"
        >
            <h2 id="contact-details-title">Datos de contacto</h2>
            <p>
                <a href={`tel:${CONTACT.phoneE164}`}>{CONTACT.phone}</a>
            </p>
            <p>
                <a href={CONTACT.maps} target="_blank" rel="noopener noreferrer">
                    {CONTACT.address}
                    <span class="visually-hidden">(Cómo llegar, se abre en una pestaña nueva)</span>
                </a>
            </p>
            <p>
                <a href={`mailto:${CONTACT.mail}`}>{CONTACT.mail}</a>
            </p>
        </section>
        <form class="surface-card form-card contact-form" action="/api/sendgrid/" method="POST">
            <h2>Por favor ingrese los siguientes datos</h2>
            <p id="contact-required-note">
                Los campos marcados con <abbr title="obligatorio">*</abbr> son obligatorios.
            </p>
            <div id="contact-status" role="alert" aria-live="assertive"></div>
            <div class="field">
                <label class="field-label" for="service">
                    Selecciona el servicio que requieres:
                </label>
                <select class="field-control" name="clientService" id="service">
                    <option value="">Selecciona un servicio</option>
                    <option value="Insolvencia">
                        Insolvencia de persona natural no comerciante
                    </option>
                    <option value="Reorganizacion">Reorganización Empresarial</option>
                    <option value="Liquidacion">Liquidacion Patrimonial</option>
                    <option value="Otro">Otros Servicios</option>
                </select>
            </div>
            <div class="field">
                <label class="field-label" for="name">
                    Nombre:
                    <abbr title="obligatorio">*</abbr>
                    <span class="visually-hidden">obligatorio</span>
                </label>
                <input
                    class="field-control"
                    name="clientName"
                    id="name"
                    type="text"
                    autocomplete="name"
                    required
                    aria-required="true"
                    aria-describedby="name-error"
                />
                <p class="field-error" id="name-error"></p>
            </div>
            <div class="field">
                <label class="field-label" for="phone">
                    Teléfono de contacto:
                    <abbr title="obligatorio">*</abbr>
                    <span class="visually-hidden">obligatorio</span>
                </label>
                <input
                    class="field-control"
                    name="clientPhone"
                    id="phone"
                    type="tel"
                    autocomplete="tel"
                    required
                    aria-required="true"
                    aria-describedby="phone-error"
                />
                <p class="field-error" id="phone-error"></p>
            </div>
            <div class="field">
                <label class="field-label" for="email">
                    Correo electronico de contacto:
                    <abbr title="obligatorio">*</abbr>
                    <span class="visually-hidden">obligatorio</span>
                </label>
                <input
                    class="field-control"
                    name="clientEmail"
                    id="email"
                    type="email"
                    autocomplete="email"
                    required
                    aria-required="true"
                    aria-describedby="email-error"
                />
                <p class="field-error" id="email-error"></p>
            </div>
            <div class="field">
                <label class="field-label" for="text">
                    Mensaje:
                    <abbr title="obligatorio">*</abbr>
                    <span class="visually-hidden">obligatorio</span>
                </label>
                <textarea
                    class="field-control"
                    name="clientMessage"
                    id="text"
                    autocomplete="off"
                    required
                    aria-required="true"
                    aria-describedby="text-error"
                ></textarea>
                <p class="field-error" id="text-error"></p>
            </div>
            <Button type="submit" variant="primary">
                Enviar Mensaje
            </Button>
        </form>
    </div>
</Layout>

<script>
    const form = document.querySelector<HTMLFormElement>('.contact-form');
    const status = document.querySelector<HTMLElement>('#contact-status');
    if (form && status) {
        const fields = ['name', 'phone', 'email', 'text']
            .map((id) => document.getElementById(id))
            .filter((field): field is HTMLInputElement | HTMLTextAreaElement => field !== null);

        const messageFor = (field: HTMLInputElement | HTMLTextAreaElement) => {
            if (field.validity.valueMissing) {
                return 'Este campo es obligatorio.';
            }
            if (field.validity.typeMismatch) {
                return 'Ingresa un correo electrónico válido.';
            }
            return field.validationMessage || 'Revisa este campo.';
        };

        const showError = (field: HTMLInputElement | HTMLTextAreaElement, message: string) => {
            const error = document.getElementById(`${field.id}-error`);
            if (error) {
                error.textContent = message;
            }
            if (message) {
                field.setAttribute('aria-invalid', 'true');
            } else {
                field.removeAttribute('aria-invalid');
            }
        };

        let summarizing = false;
        fields.forEach((field) => {
            field.addEventListener('invalid', (event) => {
                event.preventDefault();
                showError(field, messageFor(field));
                if (summarizing) {
                    return;
                }
                summarizing = true;
                queueMicrotask(() => {
                    summarizing = false;
                    const messages = fields.flatMap((item) => {
                        if (item.validity.valid) {
                            return [];
                        }
                        const error = document.getElementById(`${item.id}-error`);
                        const label = form.querySelector(`label[for="${item.id}"]`);
                        const name =
                            Array.from(label?.childNodes ?? [])
                                .filter((node) => node.nodeType === Node.TEXT_NODE)
                                .map((node) => node.textContent ?? '')
                                .join(' ')
                                .replace(/\s+/g, ' ')
                                .trim() || item.id;
                        return [`${name} ${error?.textContent ?? ''}`];
                    });
                    status.textContent = messages.join(' ');
                    fields.find((item) => !item.validity.valid)?.focus();
                });
            });
            field.addEventListener('input', () => {
                if (field.validity.valid) {
                    showError(field, '');
                }
            });
        });
    }
</script>
