---
import Layout from '../layouts/Layout.astro';
import { CONTACT, LABELS, PAGE_SEO, PATHS } from '../lib/site';
---

<Layout seo={PAGE_SEO.error}>
    <div class="container">
        <div class="surface-card message">
            <h1>Ha ocurrido un error</h1>
            <p>
                Si el error es persistente contactanos al siguiente correo electronico —
                <a href={`mailto:${CONTACT.supportMail}`}>{CONTACT.supportMail}</a>
            </p>
            <a href={PATHS.home}>{`Volver al ${LABELS.home}`}</a>
        </div>
    </div>
</Layout>
