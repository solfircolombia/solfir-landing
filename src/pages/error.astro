---
import Layout from '../layouts/Layout.astro';
import { CONTACT, LABELS, PAGE_SEO, PATHS } from '../lib/site';
---

<Layout seo={PAGE_SEO.error}>
    <div class="error">
        <div class="error-wrapper">
            <div class="error-message-box">
                <h1 class="error-message-box-title">Ha ocurrido un error</h1>
                <span class="error-message-box-text">
                    Si el error es persistente contactanos al siguiente correo electronico -
                    <a class="error-message-box-text-mail" href={`mailto:${CONTACT.supportMail}`}>
                        {CONTACT.supportMail}
                    </a>
                </span>
                <a class="error-message-box-back" href={PATHS.home}>{`Volver al ${LABELS.home}`}</a>
            </div>
        </div>
    </div>
</Layout>
