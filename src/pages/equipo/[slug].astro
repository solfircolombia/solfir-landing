---
import Layout from '../../layouts/Layout.astro';
import ContentImage from '../../components/ContentImage.astro';
import Icon from '../../components/Icon.astro';
import { getTeamMembers, type TeamMember } from '../../lib/contentful';
import { renderRichText } from '../../lib/rich-text';
import { teamPath } from '../../lib/site';

export async function getStaticPaths() {
    const members = await getTeamMembers();
    return members.map((member) => ({
        params: { slug: member.slug },
        props: { member },
    }));
}

interface Props {
    member: TeamMember;
}

const { member } = Astro.props;
const description = renderRichText(member.description);
---

<Layout
    seo={{
        title: member.name,
        description: member.role,
        pathname: teamPath(member.slug),
        image: member.avatar?.url,
        ogType: 'website',
    }}
>
    <div class="container band">
        <div class="profile">
            <aside class="profile-card">
                <div class="profile-card-main">
                    <div class="avatar">
                        {
                            member.avatar && (
                                <ContentImage
                                    image={member.avatar}
                                    alt=""
                                    widths={[195, 400]}
                                    sizes="168px"
                                    loading="eager"
                                />
                            )
                        }
                    </div>
                    <h1>{member.name}</h1>
                    <span>{member.role}</span>
                </div>
                <div class="profile-card-contact">
                    <h2>Contacto</h2>
                    <div class="profile-links">
                        {
                            member.cv.profiles.map((profile) => {
                                if (profile.network === 'LinkedIn' && profile.url) {
                                    return (
                                        <a
                                            href={profile.url}
                                            target="_blank"
                                            rel="noopener noreferrer"
                                            aria-label={`LinkedIn de ${member.name}`}
                                        >
                                            <Icon name="linkedin" />
                                        </a>
                                    );
                                }
                                if (profile.network === 'Email' && profile.url) {
                                    return (
                                        <a
                                            href={`mailto:${profile.url}`}
                                            aria-label={`Enviar correo a ${member.name}`}
                                        >
                                            <Icon name="mail" />
                                        </a>
                                    );
                                }
                                return null;
                            })
                        }
                    </div>
                </div>
            </aside>
            <div class="surface-card" style="padding: 1.5rem">
                <section class="resume-block">
                    <h2>Perfil Profesional</h2>
                    <div class="prose" set:html={description} />
                </section>
                <section class="resume-block">
                    <h2>Experiencia</h2>
                    {
                        member.cv.work.map((workItem) => (
                            <div class="resume-item">
                                <h3>{workItem.name}</h3>
                                <span class="resume-meta">
                                    {workItem.position} ({workItem.startDate} – {workItem.endDate})
                                </span>
                                {workItem.summary && <p>{workItem.summary}</p>}
                                {workItem.highlights && workItem.highlights.length > 0 && (
                                    <ul>
                                        {workItem.highlights.map((highlight) => (
                                            <li>{highlight}</li>
                                        ))}
                                    </ul>
                                )}
                            </div>
                        ))
                    }
                </section>
                <section class="resume-block">
                    <h2>Educación</h2>
                    {
                        member.cv.education.map((item) => (
                            <div class="resume-item">
                                <h3>{item.area}</h3>
                                <span class="resume-meta">
                                    {item.institution} ({item.startDate} – {item.endDate})
                                </span>
                            </div>
                        ))
                    }
                </section>
            </div>
        </div>
    </div>
</Layout>
