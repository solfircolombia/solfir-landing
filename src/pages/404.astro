---
import Layout from '../layouts/Layout.astro';
import { LABELS, PAGE_SEO, PATHS } from '../lib/site';
---

<Layout seo={PAGE_SEO.notFound}>
    <div class="container">
        <div class="surface-card message">
            <h1>Pagina no encontrada</h1>
            <p>Lo siento, la página que estas buscando no existe</p>
            <a href={PATHS.home}>{`Volver al ${LABELS.home}`}</a>
        </div>
    </div>
</Layout>
