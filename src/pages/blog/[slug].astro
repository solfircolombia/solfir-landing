---
import Layout from '../../layouts/Layout.astro';
import ContentImage from '../../components/ContentImage.astro';
import RecentPosts from '../../components/RecentPosts.astro';
import { getBlogPosts, type BlogPost } from '../../lib/contentful';
import { renderRichText } from '../../lib/rich-text';
import { blogPath, formatLongDate, teamPath } from '../../lib/site';

export async function getStaticPaths() {
    const posts = await getBlogPosts();
    return posts.map((post) => ({
        params: { slug: post.slug },
        props: { post },
    }));
}

interface Props {
    post: BlogPost;
}

const { post } = Astro.props;
const html = renderRichText(post.content);
---

<Layout
    seo={{
        title: post.title,
        description: post.summary,
        pathname: blogPath(post.slug),
        image: post.image?.url,
        ogType: 'article',
    }}
>
    <article class="container band">
        <h1 class="section-title">{post.title}</h1>
        <p class="meta">
            {post.date && formatLongDate(post.date)}
            {
                post.author && (
                    <>
                        {' '}
                        | Autor — <a href={teamPath(post.author.slug)}>{post.author.name}</a>
                    </>
                )
            }
        </p>
        <div class="post-layout">
            <div>
                {
                    post.image && (
                        <div class="post-hero">
                            <ContentImage
                                image={post.image}
                                alt={post.title}
                                widths={[480, 768, 1024, 1200]}
                                sizes="(max-width: 1024px) 100vw, 720px"
                                loading="eager"
                            />
                        </div>
                    )
                }
                <div class="prose" set:html={html} />
            </div>
            <RecentPosts />
        </div>
    </article>
</Layout>
